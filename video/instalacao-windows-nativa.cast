[2.885, "o", "1"]
[2.93, "o", "\r\n"]
[3.83, "o", "\u001b[32m[OK   ] Executando com privilegios de administrador.\u001b[0m\r\n"]
[4.28, "o", "\r\n==============================================================\r\n"]
[4.33, "o", "\u001b[36m[INFO ] SisPatrimonio Pro - Instalador WINDOWS (nativo) v1.2.0-win (2026-10-16 09:41:07)\u001b[0m\r\n"]
[4.38, "o", "\u001b[97m==============================================================\u001b[0m\r\n\r\n"]
[4.73, "o", "\u001b[32m[OK   ] Python 3.12 detectado.\u001b[0m\r\n"]
[4.79, "o", "\u001b[32m[OK   ] Git detectado.\u001b[0m\r\n"]
[4.85, "o", "\u001b[33m[AVISO] Nenhum servidor MariaDB/MySQL detectado (sera instalado MariaDB - decisao D3).\u001b[0m\r\n"]
[4.91, "o", "\u001b[33m[AVISO] Cliente mysql/mariadb nao encontrado - sera provido com o servidor.\u001b[0m\r\n"]
[5.87, "o", "\r\nSenha do banco (min. 12 caracteres; ENTER vazio nas duas = gerar automaticamente): "]
[7.57, "o", "\r\nConfirme a senha (vazio nas duas = tentar senha vazia): "]
[8.87, "o", "\r\n"]
[9.37, "o", "\r\n"]
[9.47, "o", "\u001b[97m  RESUMO DA INSTALACAO\u001b[0m\r\n"]
[9.51, "o", "    Diretorio    : C:\\SisPatrimonioPro\r\n"]
[9.55, "o", "    Repositorio  : https://github.com/wellingtonsr1/SisPatrimonioPro.git (branch main)\r\n"]
[9.59, "o", "    Banco        : sispatrimoniopro_db (usuario sispat em 127.0.0.1:3306)\r\n"]
[9.63, "o", "    Aplicacao    : 0.0.0.0:8000\r\n"]
[9.67, "o", "    Tarefa       : sispatrimoniopro (roda como SYSTEM)\r\n"]
[9.71, "o", "\r\n"]
[10.31, "o", "  Confirmar e iniciar a instalacao? (s/N): "]
[11.41, "o", "s"]
[11.5, "o", "\r"]
[11.59, "o", "\n"]
[11.68, "o", "\u001b[32m[OK   ] Confirmado.\u001b[0m\r\n"]
[12.23, "o", "\r\n"]
[12.33, "o", "\u001b[97m-- [1/16] Pacotes do sistema (Python, Git, MariaDB)\u001b[0m\r\n"]
[12.47, "o", "\u001b[36m[INFO ] Instalando MariaDB Server via winget (MariaDB.Server; pode levar alguns minutos)...\u001b[0m\r\n"]
[14.93, "o", "\u001b[32m[OK   ] Python 3.12 atende ao requisito (>= 3.10).\u001b[0m\r\n"]
[14.99, "o", "\u001b[32m[OK   ] Git disponivel.\u001b[0m\r\n"]
[15.05, "o", "\u001b[36m[INFO ] Iniciando o servico do banco (MariaDB)...\u001b[0m\r\n"]
[16.31, "o", "\u001b[32m[OK   ] Servico de banco ativo: MariaDB\u001b[0m\r\n"]
[16.37, "o", "\u001b[32m[OK   ] Cliente de banco: C:\\Program Files\\MariaDB 11.4\\bin\\mysql.exe\u001b[0m\r\n"]
[16.72, "o", "\r\n"]
[16.82, "o", "\u001b[97m-- [2/16] Verificacao de conectividade\u001b[0m\r\n"]
[16.96, "o", "\u001b[32m[OK   ] Repositorio acessivel e branch 'main' existe.\u001b[0m\r\n"]
[17.31, "o", "\r\n"]
[17.41, "o", "\u001b[97m-- [3/16] Codigo-fonte (clone)\u001b[0m\r\n"]
[17.55, "o", "\u001b[32m[OK   ] Repositorio clonado (branch main) em C:\\SisPatrimonioPro.\u001b[0m\r\n"]
[17.9, "o", "\r\n"]
[18.0, "o", "\u001b[97m-- [4/16] Ambiente virtual e dependencias\u001b[0m\r\n"]
[18.14, "o", "\u001b[36m[INFO ] Instalando requirements.txt (do repositorio recem-clonado; leva alguns minutos)...\u001b[0m\r\n"]
[20.4, "o", "\u001b[36m[INFO ] Garantindo cryptography e tzdata (autenticacao MySQL 8 / Timezone Windows)...\u001b[0m\r\n"]
[21.56, "o", "\u001b[32m[OK   ] Dependencias instaladas e validadas (imports OK).\u001b[0m\r\n"]
[21.86, "o", "\r\n"]
[21.96, "o", "\u001b[97m-- [5/16] Montagem da URL do banco\u001b[0m\r\n"]
[22.1, "o", "\u001b[32m[OK   ] DATABASE_URL montado com percent-encoding (senha nunca em argv/log).\u001b[0m\r\n"]
[22.4, "o", "\r\n"]
[22.5, "o", "\u001b[97m-- [6/16] Banco de dados (criacao/validacao)\u001b[0m\r\n"]
[22.64, "o", "\u001b[32m[OK   ] Acesso administrativo via root validado.\u001b[0m\r\n"]
[23.14, "o", "\u001b[32m[OK   ] Banco 'sispatrimoniopro_db' pronto (criado ou ja existente; utf8mb4/utf8mb4_unicode_ci).\u001b[0m\r\n"]
[23.2, "o", "\u001b[32m[OK   ] Usuario 'sispat' (localhost e 127.0.0.1) garantido.\u001b[0m\r\n"]
[23.26, "o", "\u001b[32m[OK   ] Privilegios garantidos apenas em 'sispatrimoniopro_db'.* (sem privilegios globais - SR-003).\u001b[0m\r\n"]
[23.61, "o", "\r\n"]
[23.71, "o", "\u001b[97m-- [7/16] Certificados SSL (HTTPS local)\u001b[0m\r\n"]
[23.85, "o", "\u001b[36m[INFO ] IP da LAN para o SAN: 192.168.0.15\u001b[0m\r\n"]
[24.45, "o", "\u001b[32m[OK   ] Certificados SSL gerados em data\\ssl - a aplicacao subira em HTTPS.\u001b[0m\r\n"]
[24.8, "o", "\r\n"]
[24.9, "o", "\u001b[97m-- [8/16] Arquivo de configuracao .env\u001b[0m\r\n"]
[25.04, "o", "\u001b[32m[OK   ] .env gerado com ACL restrita (equivalente 0600 - SR-002).\u001b[0m\r\n"]
[25.39, "o", "\r\n"]
[25.49, "o", "\u001b[97m-- [9/16] Teste de conexao com o banco\u001b[0m\r\n"]
[25.63, "o", "\u001b[32m[OK   ] Conexao validada via DATABASE_URL (esquema mysql+pymysql).\u001b[0m\r\n"]
[25.98, "o", "\r\n"]
[26.08, "o", "\u001b[97m-- [10/16] Tarefa agendada (servico)\u001b[0m\r\n"]
[26.22, "o", "\u001b[32m[OK   ] Tarefa agendada 'sispatrimoniopro' instalada (dispara no boot; reinicia ate 3x em falha).\u001b[0m\r\n"]
[26.62, "o", "\r\n"]
[26.72, "o", "\u001b[97m-- [11/16] Sanity pre-start\u001b[0m\r\n"]
[26.86, "o", "\u001b[32m[OK   ] Arquivos do servico presentes (.env, venv, run.py).\u001b[0m\r\n"]
[27.21, "o", "\r\n"]
[27.31, "o", "\u001b[97m-- [12/16] Parada da tarefa de rodada anterior\u001b[0m\r\n"]
[27.45, "o", "\u001b[32m[OK   ] Tarefa sispatrimoniopro instalada, mas inativa - nada a parar.\u001b[0m\r\n"]
[27.8, "o", "\r\n"]
[27.9, "o", "\u001b[97m-- [13/16] Inicializacao do schema (init_db)\u001b[0m\r\n"]
[28.04, "o", "\u001b[36m[INFO ] Executando init_db() do projeto (create_all + migracoes leves)...\u001b[0m\r\n"]
[29.7, "o", "\u001b[32m[OK   ] Schema verificado/criado via init_db() do projeto.\u001b[0m\r\n"]
[30.0, "o", "\r\n"]
[30.1, "o", "\u001b[97m-- [14/16] Start + health check\u001b[0m\r\n"]
[30.24, "o", "\u001b[36m[INFO ] Aguardando /health (ate 120s)...\u001b[0m\r\n"]
[32.3, "o", "\u001b[32m[OK   ] Aplicacao saudavel: /health -> healthy\u001b[0m\r\n"]
[32.7, "o", "\r\n"]
[32.8, "o", "\u001b[97m-- [15/16] Bateria pos-instalacao\u001b[0m\r\n"]
[32.94, "o", "\u001b[32m[OK   ] Python >= 3.10: OK\u001b[0m\r\n"]
[32.99, "o", "\u001b[32m[OK   ] venv + dependencias: OK\u001b[0m\r\n"]
[33.04, "o", "\u001b[32m[OK   ] Banco ativo (MariaDB): OK\u001b[0m\r\n"]
[33.09, "o", "\u001b[32m[OK   ] Conexao com o banco: OK\u001b[0m\r\n"]
[33.14, "o", "\u001b[32m[OK   ] Tabela base (users) existente: OK\u001b[0m\r\n"]
[33.19, "o", "\u001b[32m[OK   ] Tarefa sispatrimoniopro ativa: OK\u001b[0m\r\n"]
[33.24, "o", "\u001b[32m[OK   ] https://127.0.0.1:8000/health: OK\u001b[0m\r\n"]
[33.29, "o", "\u001b[32m[OK   ] Bateria completa: todas as verificacoes passaram.\u001b[0m\r\n"]
[33.69, "o", "\r\n"]
[33.79, "o", "\u001b[97m-- [16/16] Auditoria de seguranca\u001b[0m\r\n"]
[33.93, "o", "\u001b[32m[OK   ] Auto-check: nenhuma credencial no log (SR-001).\u001b[0m\r\n"]
[33.98, "o", "\u001b[32m[OK   ] .env com ACL restrita (equivalente 0600 - SR-002).\u001b[0m\r\n"]
[34.03, "o", "\u001b[32m[OK   ] Usuario do banco sem privilegios globais (SR-003) - grants aplicados somente no banco da aplicacao.\u001b[0m\r\n"]
[34.53, "o", "\u001b[32m[OK   ] Regra de firewall de entrada criada para a porta 8000 (acesso via rede).\u001b[0m\r\n"]
[35.13, "o", "\r\n"]
[35.23, "o", "\u001b[97m  ==============================================================\u001b[0m\r\n"]
[35.35, "o", "\u001b[32m[OK   ] SisPatrimonio Pro instalado com sucesso (WINDOWS nativo)!\u001b[0m\r\n"]
[35.47, "o", "\u001b[97m  ==============================================================\u001b[0m\r\n"]
[35.97, "o", "\r\n"]
[36.07, "o", "\u001b[97m  ACESSO\u001b[0m\r\n"]
[36.11, "o", "    Aplicacao    : https://192.168.0.15:8000\r\n"]
[36.14, "o", "    Swagger API  : https://192.168.0.15:8000/docs\r\n"]
[36.17, "o", "    Health check : https://192.168.0.15:8000/health\r\n"]
[36.2, "o", "    HTTPS        : importe C:\\SisPatrimonioPro\\data\\ssl\\ca.crt como CA confiavel nos aparelhos (1x).\r\n"]
[36.23, "o", "\r\n"]
[36.33, "o", "\u001b[97m  INSTALACAO\u001b[0m\r\n"]
[36.37, "o", "    Diretorio    : C:\\SisPatrimonioPro\r\n"]
[36.4, "o", "    Configuracao : C:\\SisPatrimonioPro\\.env (ACL restrita - contem credenciais)\r\n"]
[36.43, "o", "    Tarefa       : sispatrimoniopro (roda como SYSTEM no boot)\r\n"]
[36.46, "o", "    Log          : C:\\ProgramData\\sispatrimonio-install.log\r\n"]
[36.49, "o", "    Logs/Backups : C:\\SisPatrimonioPro\\data\\logs | C:\\SisPatrimonioPro\\data\\backups\r\n"]
[36.52, "o", "\r\n"]
[36.62, "o", "\u001b[97m  GERENCIAR O SERVICO\u001b[0m\r\n"]
[36.66, "o", "    Get-ScheduledTask -TaskName sispatrimoniopro        # estado\r\n"]
[36.69, "o", "    Start-ScheduledTask -TaskName sispatrimoniopro      # iniciar\r\n"]
[36.72, "o", "    Stop-ScheduledTask -TaskName sispatrimoniopro       # parar\r\n"]
[36.75, "o", "    Unregister-ScheduledTask -TaskName sispatrimoniopro # remover (o desinstalador faz isso)\r\n"]
[36.78, "o", "\r\n"]
[36.88, "o", "\u001b[97m  PRIMEIRO ADMINISTRADOR (escolha um caminho - nunca exibimos senhas)\u001b[0m\r\n"]
[36.92, "o", "    A) CLI (recomendado):\r\n"]
[36.95, "o", "       cd \"C:\\SisPatrimonioPro\"\r\n"]
[36.98, "o", "       .venv\\Scripts\\python.exe -m app.cli create-user --username admin --name \"Administrador\" --admin\r\n"]
[37.01, "o", "       (a senha e solicitada de forma oculta; minimo 8 caracteres)\r\n"]
[37.04, "o", "    B) Primeiro acesso: abra a aplicacao e use a pagina /setup\r\n"]
[37.07, "o", "       (disponivel enquanto nao existir nenhum usuario)\r\n"]
[37.1, "o", "    C) Variaveis de ambiente: AUTH_ADMIN_USERNAME/AUTH_ADMIN_PASSWORD\r\n"]
[37.13, "o", "       no .env antes do primeiro start (remova apos o primeiro login)\r\n"]
[37.16, "o", "\r\n"]
[37.26, "o", "  A senha do banco NAO aparece neste resumo nem no log - esta apenas\r\n"]
[37.29, "o", "  no .env (DATABASE_URL), com ACL restrita.\r\n"]
[37.32, "o", "\u001b[97m  ==============================================================\u001b[0m\r\n"]
[37.82, "o", "\u001b[32m[OK   ] Concluido.\u001b[0m\r\n"]
