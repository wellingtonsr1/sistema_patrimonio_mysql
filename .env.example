# Exemplo de variáveis de ambiente do SisPatrimônio Pro.
# Copie para .env e ajuste os valores do seu servidor.
# NUNCA coloque credenciais reais neste arquivo.

# Conexão com o banco MariaDB/MySQL (obrigatória — a aplicação não inicia sem ela):
# DATABASE_URL=mariadb+pymysql://usuario:senha@localhost:3306/sispatrimonio_pro

# Caminho do executável mysqldump (opcional — feature 018).
# Necessário no Windows quando o utilitário não está no PATH do processo.
# Exemplo com XAMPP (ajuste à sua instalação):
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
MYSQLDUMP_PATH=

# Deadline de relógio (segundos) da importação do restore (opcional — feature 019).
# Padrão 900. Aumente para bancos maiores (o import é abortado ao estourar).
BACKUP_IMPORT_TIMEOUT=900

# ============================================================================
# NOTIFICAÇÕES POR E-MAIL (feature 030) — parâmetros de ENVIO via SMTP.
# A ativação e os destinatários são configurados na TELA
# (Administração → Notificações, permissão notificacoes.gerenciar).
# Aqui fica apenas a conexão do servidor de e-mail. SMTP_PASSWORD é SEGREDO:
# só no .env do servidor — nunca em banco, tela, logs ou auditoria.
# Sem SMTP_HOST configurado, a notificação fica inoperante (falha registrada
# na auditoria; a movimentação NUNCA é afetada).
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_SEND_TIMEOUT=10
